rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserDoc(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'avatar', 'handle', 'role', 'bio',
          'targetCompany', 'targetPackage', 'college', 'graduationYear', 'phone',
          'githubUrl', 'linkedinUrl', 'leetcodeUrl', 'codechefUrl',
          'portfolioUrl', 'instagramUrl', 'totalSolved', 'totalBookmarks',
          'codingProfiles', 'authProvider', 'loginCount', 'lastLoginAt',
          'loginHistory', 'createdAt', 'updatedAt', 'lastActiveAt'
        ])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 500))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 500))
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2000))
        && (!('handle' in request.resource.data) || (request.resource.data.handle is string && request.resource.data.handle.size() <= 500))
        && (!('role' in request.resource.data) || (request.resource.data.role is string && request.resource.data.role.size() <= 500))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 2000))
        && (!('targetCompany' in request.resource.data) || (request.resource.data.targetCompany is string && request.resource.data.targetCompany.size() <= 500))
        && (!('targetPackage' in request.resource.data) || (request.resource.data.targetPackage is string && request.resource.data.targetPackage.size() <= 500))
        && (!('college' in request.resource.data) || (request.resource.data.college is string && request.resource.data.college.size() <= 500))
        && (!('graduationYear' in request.resource.data) || (request.resource.data.graduationYear is string && request.resource.data.graduationYear.size() <= 500))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 100))
        && (!('githubUrl' in request.resource.data) || (request.resource.data.githubUrl is string && request.resource.data.githubUrl.size() <= 1000))
        && (!('linkedinUrl' in request.resource.data) || (request.resource.data.linkedinUrl is string && request.resource.data.linkedinUrl.size() <= 1000))
        && (!('leetcodeUrl' in request.resource.data) || (request.resource.data.leetcodeUrl is string && request.resource.data.leetcodeUrl.size() <= 1000))
        && (!('codechefUrl' in request.resource.data) || (request.resource.data.codechefUrl is string && request.resource.data.codechefUrl.size() <= 1000))
        && (!('portfolioUrl' in request.resource.data) || (request.resource.data.portfolioUrl is string && request.resource.data.portfolioUrl.size() <= 1000))
        && (!('instagramUrl' in request.resource.data) || (request.resource.data.instagramUrl is string && request.resource.data.instagramUrl.size() <= 1000))
        && (!('authProvider' in request.resource.data) || (request.resource.data.authProvider is string && request.resource.data.authProvider.size() <= 500))
        && (!('lastLoginAt' in request.resource.data) || (request.resource.data.lastLoginAt is string && request.resource.data.lastLoginAt.size() <= 500))
        && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 500))
        && (!('updatedAt' in request.resource.data) || (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 500))
        && (!('lastActiveAt' in request.resource.data) || (request.resource.data.lastActiveAt is string && request.resource.data.lastActiveAt.size() <= 500))
        && (!('totalSolved' in request.resource.data) || (request.resource.data.totalSolved is number && request.resource.data.totalSolved >= 0))
        && (!('totalBookmarks' in request.resource.data) || (request.resource.data.totalBookmarks is number && request.resource.data.totalBookmarks >= 0))
        && (!('loginCount' in request.resource.data) || (request.resource.data.loginCount is number && request.resource.data.loginCount >= 0))
        && (!('loginHistory' in request.resource.data) || (request.resource.data.loginHistory is list && request.resource.data.loginHistory.size() <= 50))
        && (!('codingProfiles' in request.resource.data) || request.resource.data.codingProfiles is map);
    }

    function isValidProgressDoc(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'solvedMap', 'totalSolved', 'bookmarksMap', 'notesMap',
          'customDataMap', 'activityDates', 'streakDays', 'longestStreak',
          'lastActiveAt', 'lastSyncedAt', 'codingProfiles'
        ])
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('solvedMap' in request.resource.data) || (request.resource.data.solvedMap is map && request.resource.data.solvedMap.size() <= 10000))
        && (!('bookmarksMap' in request.resource.data) || (request.resource.data.bookmarksMap is map && request.resource.data.bookmarksMap.size() <= 10000))
        && (!('notesMap' in request.resource.data) || (request.resource.data.notesMap is map && request.resource.data.notesMap.size() <= 5000))
        && (!('customDataMap' in request.resource.data) || (request.resource.data.customDataMap is map && request.resource.data.customDataMap.size() <= 2000))
        && (!('activityDates' in request.resource.data) || (request.resource.data.activityDates is list && request.resource.data.activityDates.size() <= 4000))
        && (!('totalSolved' in request.resource.data) || (request.resource.data.totalSolved is number && request.resource.data.totalSolved >= 0))
        && (!('streakDays' in request.resource.data) || (request.resource.data.streakDays is number && request.resource.data.streakDays >= 0))
        && (!('longestStreak' in request.resource.data) || (request.resource.data.longestStreak is number && request.resource.data.longestStreak >= 0))
        && (!('lastActiveAt' in request.resource.data) || (request.resource.data.lastActiveAt is string && request.resource.data.lastActiveAt.size() <= 50))
        && (!('lastSyncedAt' in request.resource.data) || (request.resource.data.lastSyncedAt is string && request.resource.data.lastSyncedAt.size() <= 50))
        && (!('codingProfiles' in request.resource.data) || request.resource.data.codingProfiles is map);
    }

    function isValidMessageDoc() {
      return request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200)
        && (request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320)
        && (request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000)
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Public contact form can create validated messages; no public read/update/delete.
    match /messages/{id} {
      allow create: if isValidMessageDoc();
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidUserDoc(userId);

      match /login_history/{loginId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /progress/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidProgressDoc(userId);
    }
  }
}
